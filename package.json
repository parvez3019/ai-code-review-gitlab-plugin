{
  "name": "@parvez3019/ai-code-review-gitlab-plugin",
  "version": "0.2.0",
  "description": "AI code review bot for GitLab merge requests: inline review comments using Claude (AWS Bedrock or Anthropic API), Gemini, OpenAI or local models via Ollama. Drop-in GitLab CI job.",
  "main": "lib/index.js",
  "bin": {
    "ai-code-review-gitlab-plugin": "bin/index.js"
  },
  "scripts": {
    "start": "tsc --watch",
    "build": "tsc && cp -r src/prompts lib/",
    "test": "npm run build && node --test test/*.test.js"
  },
  "files": [
    "lib",
    "bin"
  ],
  "license": "MIT",
  "author": "parvez3019",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parvez3019/ai-code-review-gitlab-plugin"
  },
  "bugs": {
    "url": "https://github.com/parvez3019/ai-code-review-gitlab-plugin/issues"
  },
  "homepage": "https://parvez3019.github.io/ai-code-review-gitlab-plugin/",
  "keywords": [
    "ai-code-review",
    "code-review",
    "code-review-bot",
    "gitlab",
    "gitlab-ci",
    "gitlab-merge-request",
    "merge-request",
    "pull-request-review",
    "ai",
    "llm",
    "claude",
    "anthropic",
    "aws-bedrock",
    "bedrock",
    "gemini",
    "openai",
    "ollama",
    "ci-cd",
    "devops",
    "static-analysis"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@aws-sdk/client-bedrock-runtime": "^3.525.0",
    "@aws-sdk/client-s3": "^3.824.0",
    "axios": "^1.4.0",
    "commander": "^10.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3"
  }
}
